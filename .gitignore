# --- Ruby / Bundler -----------------------------------------------------------
# Vendored gems are installed per-site; deployers run `bundle install` themselves.
/.bundle/
/vendor/bundle/
*.gem

# --- Passenger / Open OnDemand runtime ---------------------------------------
# `tmp/restart.txt` is touched to restart the app; logs are per-deployment.
/tmp/
/log/
*.log
*.pid

# --- Local test data -----------------------------------------------------------
# Never commit real Nextflow/nf-core run artifacts (may contain user data/paths).
.nextflow/
.nextflow.log*
work/
results/
pipeline_info/

# --- Secrets / local environment ---------------------------------------------
.env
.env.*
*.pem
*.key

# --- Editors / IDEs ------------------------------------------------------------
.idea/
.vscode/
*.swp
*.swo
*~
\#*\#
.#*

# --- OS files ------------------------------------------------------------------
.DS_Store
Thumbs.db

# --- Claude Code local settings ------------------------------------------------
.claude/settings.local.json
